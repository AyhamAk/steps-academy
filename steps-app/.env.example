# Backend API URL. Local dev: your machine's LAN IP (not localhost — the
# phone/simulator needs to reach it over the network), e.g. http://10.0.0.5:4000
# Production: the real hosted backend URL (Railway/Render), never a LAN IP.
EXPO_PUBLIC_API_URL=http://localhost:4000

# Google OAuth client IDs — see Google Cloud Console > APIs & Services > Credentials
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=replace-with-your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=replace-with-your-android-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=replace-with-your-web-client-id.apps.googleusercontent.com
