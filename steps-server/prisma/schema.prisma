generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  admin
  parent
}

enum NotificationType {
  photo
  announcement
  event
  course
}

enum EnrollmentStatus {
  pending
  approved
  rejected
  cancelled
}

/// The academy runs Sunday–Thursday.
enum WeekDay {
  sun
  mon
  tue
  wed
  thu
}

/// A parent's rating and note about the app itself, read by the academy.
model Feedback {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// 1–5. Kept alongside the message so trends are readable at a glance.
  rating    Int
  message   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Small key/value store for academy-wide settings, e.g. the gallery quote.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// One activity in the recurring weekly timetable shown on Home.
model ScheduleActivity {
  id              String   @id @default(uuid())
  day             WeekDay
  name            String
  emoji           String   @default("🌟")
  /// 24-hour "HH:MM" so the day sorts correctly; formatted for display client-side.
  startTime       String
  durationMinutes Int      @default(30)
  accentColor     String?
  createdAt       DateTime @default(now())

  @@index([day])
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  name             String
  passwordHash     String?
  googleId         String?
  role             Role     @default(parent)
  pushToken        String?
  /**
   * What the parent said their child is called at sign-up. A claim only —
   * it grants nothing. An admin reads it to know who to link, then links a
   * real Student record. Never used to resolve photo visibility.
   */
  claimedChildName String?
  createdAt        DateTime @default(now())

  events        Event[]
  photos        Photo[]
  announcements Announcement[]
  notifications Notification[]
  children      ParentStudent[]

  feedback            Feedback[]
  enrollmentRequests  CourseEnrollment[] @relation("EnrollmentRequester")
  enrollmentDecisions CourseEnrollment[] @relation("EnrollmentDecider")
  invitesCreated      InviteCode[]       @relation("InvitesCreated")
  inviteRedemptions   InviteRedemption[]
}

/// A class or activity families can enrol a child in. Admin-managed.
model Course {
  id          String    @id @default(uuid())
  name        String
  description String?
  emoji       String    @default("🎓")
  instructor  String?
  /// Which days it runs on, e.g. ["sun","wed"]. Structured rather than free
  /// text so it can be shown in any language and sorted.
  weekDays    WeekDay[]
  /// 24-hour "HH:MM".
  startTime   String?
  /// Calendar range, "YYYY-MM-DD" — the term the course actually runs for.
  startDate   String?
  endDate     String?
  /// 0 means unlimited. Approved enrolments count against it.
  capacity    Int       @default(0)
  accentColor String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  enrollments CourseEnrollment[]

  @@index([isActive])
}

/// One child's enrolment in one course, and the full record of how it was
/// decided — who asked, who approved or rejected it, and when.
model CourseEnrollment {
  id        String           @id @default(uuid())
  courseId  String
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId String
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status    EnrollmentStatus @default(pending)

  requestedBy String
  requester   User     @relation("EnrollmentRequester", fields: [requestedBy], references: [id])
  requestedAt DateTime @default(now())

  decidedBy String?
  decider   User?     @relation("EnrollmentDecider", fields: [decidedBy], references: [id])
  decidedAt DateTime?
  /// Optional admin note stored with the decision.
  note      String?

  @@unique([courseId, studentId])
  @@index([courseId])
  @@index([studentId])
  @@index([status])
}

/// A child enrolled at the academy. Created by an admin — never by a parent
/// typing a name — because photo visibility is derived from these records.
model Student {
  id        String   @id @default(uuid())
  name      String
  /// ISO yyyy-mm-dd. Optional, but the practical way to tell apart two
  /// children who share a first name.
  birthDate String?
  notes     String?
  createdAt DateTime @default(now())

  guardians   ParentStudent[]
  tags        PhotoTag[]
  events      EventAttendee[]
  enrollments CourseEnrollment[]
  inviteCodes InviteCode[]

  @@index([name])
}

/// Links a parent account to a child. Many-to-many: a child can have two
/// guardians, and a guardian can have several children.
model ParentStudent {
  parentId  String
  parent    User     @relation(fields: [parentId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([parentId, studentId])
  @@index([studentId])
}

model Event {
  id        String   @id @default(uuid())
  name      String
  date      String
  // Admin-written note shown to parents on the event's gallery. One per event.
  caption   String?
  createdBy String
  creator   User     @relation(fields: [createdBy], references: [id])
  createdAt DateTime @default(now())

  photos    Photo[]
  attendees EventAttendee[]

  @@index([date])
}

/// Which students attended an event — drives auto-tagging on photo upload.
model EventAttendee {
  eventId   String
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([eventId, studentId])
  @@index([studentId])
}

model Photo {
  id      String @id @default(uuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  filename String

  // R2 object keys — null for real uploads only if externalUrl is used instead (dev-seed placeholders)
  key         String?
  thumbKey    String?
  mediumKey   String?
  // Set only for dev-seed placeholder photos (e.g. picsum.photos) that bypass R2 entirely
  externalUrl String?

  uploadedBy String
  uploader   User     @relation(fields: [uploadedBy], references: [id])
  uploadedAt DateTime @default(now())

  tags PhotoTag[]

  @@index([eventId])
}

model PhotoTag {
  id        String   @id @default(uuid())
  photoId   String
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([photoId, studentId])
  @@index([photoId])
  @@index([studentId])
}

model Announcement {
  id        String   @id @default(uuid())
  text      String
  createdBy String
  creator   User     @relation(fields: [createdBy], references: [id])
  createdAt DateTime @default(now())
}

model Notification {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  childName  String?
  eventName  String?
  eventId    String?
  /// Set on course notifications so tapping one opens that course.
  courseId   String?
  courseName String?
  read       Boolean          @default(false)
  createdAt  DateTime         @default(now())

  @@index([userId])
  @@index([userId, read])
}

/// An invite an admin hands to a family so they can create an account. The code
/// IS the proof of relationship: redeeming it links the new parent to this
/// student, which is why sign-up no longer has to ask who someone's child is.
///
/// Two uses by default, so both guardians can join off one code; after that it
/// is spent. Never hard-deleted — revoking sets `revokedAt` so the audit trail
/// survives the question "how did this person get access?".
model InviteCode {
  id        String    @id @default(uuid())
  /// Normalised: uppercase, no dashes or spaces. Displayed as XXXX-XXXX.
  code      String    @unique
  studentId String
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdBy String
  creator   User      @relation("InvitesCreated", fields: [createdBy], references: [id])
  maxUses   Int       @default(2)
  useCount  Int       @default(0)
  expiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  redemptions InviteRedemption[]

  @@index([studentId])
}

/// Which account used which code, and when.
model InviteRedemption {
  id         String     @id @default(uuid())
  codeId     String
  code       InviteCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  redeemedAt DateTime   @default(now())

  /// One account can never consume the same code twice.
  @@unique([codeId, userId])
  @@index([userId])
}
